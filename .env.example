# ---------------------------------------------------------------------------
# Required / optional secrets — never commit a filled-in copy of this file.
# These are examples, not working credentials. Replace every value.
# ---------------------------------------------------------------------------
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Create your own API app at https://my.telegram.org. The values below are only
# placeholders; Telegram rejects login-code requests made with them.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Optional. If omitted, the key is automatically and stably derived from your
# bot credentials so sessions in MongoDB survive restarts even without a volume.
# SESSION_ENCRYPTION_KEY=

# Comma-separated numeric Telegram user IDs allowed to use /admin.
ADMIN_IDS=123456789

# MongoDB (Railway: copy the private connection string from the Mongo service).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=userbot_hosting

# ---------------------------------------------------------------------------
# Storage (mount a persistent volume at DATA_DIR in production).
# ---------------------------------------------------------------------------
DATA_DIR=/data
# SESSIONS_DIR=/data/sessions
# TEMP_DIR=/data/tmp

# Railway injects PORT. For local/compose, PORT or HEALTH_PORT can be used.
# PORT=8080
HEALTH_PORT=8080

# ---------------------------------------------------------------------------
# Per-user quotas (0 means unlimited). Defaults are 8 GiB temp storage / 200
# jobs per day. Storage reservations cover the archive plus extracted videos
# only while a job is running; uploaded bytes are tracked separately.
# ---------------------------------------------------------------------------
DEFAULT_STORAGE_QUOTA_BYTES=0
DEFAULT_DAILY_TASK_QUOTA=200

# ---------------------------------------------------------------------------
# Capacity and concurrency
# ---------------------------------------------------------------------------
MAX_ACTIVE_USERBOTS=50
PER_USER_CONCURRENT_JOBS=1
PER_USER_QUEUE_SIZE=4
EXTRACT_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=2
UPLOAD_CONCURRENCY=2
DOWNLOAD_CHUNK_SIZE_KB=512
UPLOAD_CHUNK_SIZE_KB=512

# ---------------------------------------------------------------------------
# ZIP safety limits (bytes unless noted)
# ---------------------------------------------------------------------------
MAX_ZIP_SIZE_BYTES=2147483648
MAX_TOTAL_UNCOMPRESSED_BYTES=4294967296
MAX_SINGLE_FILE_BYTES=2147483648
MAX_ZIP_ENTRIES=5000
MAX_COMPRESSION_RATIO=250
MAX_ARCHIVE_DEPTH=3
# Set to 0 on low-disk hosts like Railway free tier so jobs are not falsely rejected.
MIN_FREE_DISK_BYTES=0
# 0 = send every video in the archive.
MAX_VIDEOS_PER_JOB=0

# ---------------------------------------------------------------------------
# Telegram pacing and retry policy
# ---------------------------------------------------------------------------
MIN_SECONDS_BETWEEN_REQUESTS=0
MAX_RETRIES=4
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=120
FLOODWAIT_EXTRA_SECONDS=1
UNCERTAIN_SEND_RETRIES=2

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TASK_TIMEOUT_SECONDS=3600
# 0 keeps connected accounts resident (recommended). Positive values evict
# idle accounts; the next /status brings them back on demand.
IDLE_DISCONNECT_SECONDS=0
SESSION_LEASE_SECONDS=120
PROGRESS_UPDATE_INTERVAL=5
DEFAULT_SPOILER=false
REQUIRE_SAME_ACCOUNT=true
CLEANUP_STALE_TEMP_HOURS=2

# Optional explicit worker identity (must be unique per running replica).
# WORKER_ID=
LOG_LEVEL=INFO
LOG_JSON=true
